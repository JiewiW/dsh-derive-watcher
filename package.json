{
  "name": "dsh-derive-watcher",
  "version": "0.3.3",
  "description": "语义监视者（L3）：会话语义旅程账本、flash 总结、新颖性判定、里程碑折叠、上下文注入、三级语义停滞响应，以及右侧栏干预时间线（timeline）。v0.3.2 fixes npm pack files 配置（排除 replay/transcripts 与 replay/replay-ledger 的真实会话录音、test/ 目录）。",
  "keywords": ["dsh", "deepseek-harness", "dsh-plugin", "semantic-watcher", "journey"],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "README.md",
    "LICENSE",
    "cordis.patch.yml",
    "docs/events.md",
    "replay/README.md",
    "replay/replay.mjs",
    "replay/expected-ranges.json",
    "replay/p2-25/"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "test:p225": "node --test replay/p2-25/p2-25-regression.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-slots"]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.5-rc.1 <0.2.0 || >=0.2.0-rc.1 <0.3.0-0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JiewiW/dsh-derive-watcher.git"
  },
  "homepage": "https://github.com/JiewiW/dsh-derive-watcher#readme",
  "bugs": {
    "url": "https://github.com/JiewiW/dsh-derive-watcher/issues"
  }
}
