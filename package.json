{
  "name": "dsh-derive-watcher",
  "version": "0.1.1",
  "description": "语义监视者（L3）：会话语义旅程账本、flash 总结、新颖性判定、里程碑折叠、上下文注入与三级语义停滞响应（P0-P3；stall-2/3 的 L2 联调属 P4）",
  "keywords": ["dsh", "deepseek-harness", "dsh-plugin", "semantic-watcher", "journey"],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "replay/",
    "docs/",
    "test/",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "test:p225": "node --test replay/p2-25/p2-25-regression.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.5-rc.1 <0.2.0 || >=0.2.0-rc.1 <0.3.0-0"
  },
  "license": "MIT"
}
